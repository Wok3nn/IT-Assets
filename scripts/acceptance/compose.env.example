# Copy OUTSIDE the repository to the new private acceptance directory as compose.env.
# Paths only; never put credentials or original DATABASE_URL here.
ACCEPTANCE_RUN=/home/sysadmin/it-assets-upgrade-rehearsal/acceptance-NEW-UNIQUE-RUN
ACCEPTANCE_MANAGED_IMAGE=sha256:REPLACE_WITH_LOCALLY_BUILT_IMAGE_ID
ACCEPTANCE_LEGACY_IMAGE=sha256:REPLACE_WITH_EXACT_BACKED_UP_IMAGE_ID
ACCEPTANCE_MARIADB_IMAGE=mariadb@sha256:REPLACE_WITH_BACKUP_COMPATIBLE_IMAGE_DIGEST
# Only in the separately approved SQL overlay:
# ACCEPTANCE_APPROVED_SQL_NETWORK=REPLACE_WITH_ISOLATED_EGRESS_RESTRICTED_NETWORK

# Ingress target: legacy-check, app, or rollback. Export per the operator guide when switching.
ACCEPTANCE_INGRESS_TARGET=legacy-check
