{
  "name": "it-asset-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4050",
    "build": "npm run db:generate && next build",
    "typecheck": "tsc --noEmit",
    "start": "next start -p 4050",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern next-env.d.ts --ignore-pattern scripts/seed.js",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node scripts/seed.js",
    "db:bootstrap": "node scripts/bootstrap.mjs"
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.6.3",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.511.0",
    "next": "^15.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.5.3",
    "prisma": "6.19.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
