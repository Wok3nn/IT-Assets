{
  "name": "it-asset-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:db": "node scripts/test.mjs --database",
    "db:validate": "node scripts/prisma-provider.mjs validate",
    "dev": "next dev -p 4050",
    "build": "npm run db:generate && next build",
    "typecheck": "tsc --noEmit",
    "start": "next start -p 4050",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern next-env.d.ts --ignore-pattern scripts/seed.js",
    "worker:borrowed-reminders": "tsx src/workers/borrowed-reminders-worker.ts",
    "worker:borrowed-reminders:dry-run": "tsx src/workers/borrowed-reminders-worker.ts --once --dry-run",
    "db:generate": "node scripts/prisma-provider.mjs generate",
    "db:migrate": "node scripts/prisma-provider.mjs migrate dev",
    "db:deploy": "node scripts/prisma-provider.mjs migrate deploy",
    "db:seed": "node scripts/prisma-provider.mjs db seed",
    "db:bootstrap": "node scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.511.0",
    "next": "^15.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.5.3",
    "prisma": "6.19.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
