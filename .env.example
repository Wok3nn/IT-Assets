# Optional reference file for local development or custom deployments.
# Docker Compose users can set these values directly in their compose file instead.
PORT=4050
# Publicly reachable base URL for redirects/callbacks. In Docker/proxy deployments, do not use the internal container hostname.
APP_URL=http://localhost:4050
SESSION_SECRET=change-me
# Use auto unless you need to force secure-cookie behavior manually.
SESSION_COOKIE_SECURE=auto
# Database mode/provider contract:
# - active local modes in this phase: local+postgresql, local+mariadb
# - external bootstrap mode: external+sqlserver
# - temporary compatibility bridge still exists: local+sqlite
DB_MODE=local
DB_PROVIDER=postgresql
# DATABASE_URL remains required for active local providers.
# Local PostgreSQL example. The app uses env-driven local bootstrap in this mode and continues into the normal app setup flow after the database is reachable.
DATABASE_URL=postgresql://it_assets:change-me@localhost:5432/it_assets?schema=public
# Local MariaDB example:
# DB_PROVIDER=mariadb
# DATABASE_URL=mysql://it_assets:change-me@localhost:3306/it_assets
# External SQL Server bootstrap example:
# DB_MODE=external
# DB_PROVIDER=sqlserver
# DATABASE_URL is not required on first boot in external mode.
# The /setup/db bootstrap flow stores SQL Server connection settings under APP_DATA_DIR/state/bootstrap.json
# and builds the runtime Prisma DATABASE_URL after successful connection test + migration/bootstrap.
# Runtime app data directory. Docker deployments normally use /data.
APP_DATA_DIR=/data
