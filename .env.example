# Optional reference file for local development or custom deployments.
# Docker Compose users can set these values directly in their compose file instead.
PORT=4050
# Publicly reachable base URL for redirects/callbacks. Do not include a trailing slash.
# In Docker/proxy deployments, do not use the internal container hostname.
APP_URL=http://localhost:4050
SESSION_SECRET=change-me
# Use auto unless you need to force secure-cookie behavior manually.
SESSION_COOKIE_SECURE=auto
# Database mode/provider contract:
# - recommended production deployment: local+mariadb through Docker Compose
# - local+sqlite remains only a dev/test compatibility option
# - external+sqlserver is experimental and paused
DB_MODE=local
DB_PROVIDER=mariadb
# DATABASE_URL remains required for active local providers.
# MariaDB example. In Docker Compose the host is normally the mariadb service name.
DATABASE_URL=mysql://it_assets:change-me@localhost:3306/it_assets
# External SQL Server experimental/paused example:
# DB_MODE=external
# DB_PROVIDER=sqlserver
# DATABASE_URL is not required on first boot in external mode.
# The /setup/db bootstrap flow stores SQL Server connection settings under APP_DATA_DIR/state/bootstrap.json
# and builds the runtime Prisma DATABASE_URL after successful connection test + migration/bootstrap.
# Runtime app data directory. Docker deployments normally use /data.
APP_DATA_DIR=/data

# Master key for encrypting sensitive app settings such as Exchange Email Service Client Secret.
# Generate once and keep the same value across restarts/redeployments.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SETTINGS_ENCRYPTION_KEY=
