generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@it-assets/sqlserver-client"
}

// Keep the legacy explicit single-provider generator available for existing installs.
generator legacyClient {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model SetupState {
  id            String    @id @default(cuid()) @db.NVarChar(191)
  isCompleted   Boolean   @default(false)
  siteName      String? @db.NVarChar(191)
  initializedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model User {
  id           String         @id @default(cuid()) @db.NVarChar(191)
  name         String @db.NVarChar(191)
  email        String         @unique @db.NVarChar(191)
  passwordHash String @db.NVarChar(191)
  canLogin     Boolean        @default(true)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     Session[]
  userRoles    UserRole[]
  userScopes   UserScope[]
  assets       Asset[]        @relation("AssignedUserAssets")
  borrowedItems BorrowedItem[] @relation("BorrowedItemBorrower")
  issuedBorrowedItems BorrowedItem[] @relation("BorrowedItemIssuedBy")
  returnedBorrowedItems BorrowedItem[] @relation("BorrowedItemReturnedBy")
  auditEntries AuditLog[]
}

model GuestProfile {
  id             String   @id @default(cuid()) @db.NVarChar(191)
  displayName    String @db.NVarChar(191)
  guestType      String   @default("Guest") @db.NVarChar(191)
  notes          String? @db.NVarChar(Max)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignedAssets Asset[]  @relation("AssignedGuestProfileAssets")

  @@index([displayName])
  @@index([guestType])
  @@index([isActive])
}

model Session {
  id         String   @id @default(cuid()) @db.NVarChar(191)
  token      String   @unique @db.NVarChar(191)
  userId     String @db.NVarChar(191)
  expiresAt  DateTime
  ipAddress  String? @db.NVarChar(191)
  userAgent  String? @db.NVarChar(Max)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Role {
  id        String     @id @default(cuid()) @db.NVarChar(191)
  key       String     @unique @db.NVarChar(191)
  name      String @db.NVarChar(191)
  createdAt DateTime   @default(now())
  userRoles UserRole[]
}

model Scope {
  id          String       @id @default(cuid()) @db.NVarChar(191)
  name        String @db.NVarChar(191)
  slug        String       @unique @db.NVarChar(191)
  description String? @db.NVarChar(Max)
  colorHex    String? @db.NVarChar(191)
  colorMode   String? @db.NVarChar(191)
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userScopes  UserScope[]
  assetScopes AssetScope[]
}

model UserRole {
  id     String @id @default(cuid()) @db.NVarChar(191)
  userId String @db.NVarChar(191)
  roleId String @db.NVarChar(191)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, roleId])
}

model UserScope {
  id      String @id @default(cuid()) @db.NVarChar(191)
  userId  String @db.NVarChar(191)
  scopeId String @db.NVarChar(191)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scope   Scope  @relation(fields: [scopeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, scopeId])
}

model Category {
  id                     String         @id @default(cuid()) @db.NVarChar(191)
  name                   String @db.NVarChar(191)
  slug                   String         @unique @db.NVarChar(191)
  parentId               String? @db.NVarChar(191)
  colorHex               String? @db.NVarChar(191)
  colorMode              String? @db.NVarChar(191)
  sortOrder              Int            @default(0)
  defaultLabelTemplateId String? @db.NVarChar(191)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  parent                 Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children               Category[]     @relation("CategoryTree")
  assets                 Asset[]
  defaultLabelTemplate   LabelTemplate? @relation("CategoryDefaultLabelTemplate", fields: [defaultLabelTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Location {
  id          String      @id @default(cuid()) @db.NVarChar(191)
  name        String @db.NVarChar(191)
  slug        String      @unique @db.NVarChar(191)
  parentId    String? @db.NVarChar(191)
  colorHex    String? @db.NVarChar(191)
  colorMode   String? @db.NVarChar(191)
  code        String?     @unique @db.NVarChar(191)
  description String? @db.NVarChar(Max)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parent      Location?   @relation("LocationTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Location[]  @relation("LocationTree")
  assets      Asset[]     @relation("AssignedLocationAssets")
}

model AssetStatus {
  id        String   @id @default(cuid()) @db.NVarChar(191)
  key       String   @unique @db.NVarChar(191)
  name      String @db.NVarChar(191)
  color     String? @db.NVarChar(191)
  createdAt DateTime @default(now())
  assets    Asset[]
}

model Asset {
  id                 String          @id @default(cuid()) @db.NVarChar(191)
  name               String @db.NVarChar(191)
  make               String? @db.NVarChar(191)
  model              String? @db.NVarChar(191)
  assetTag           String          @unique @db.NVarChar(191)
  serialNumber       String? @db.NVarChar(191)
  notes              String? @db.NVarChar(Max)
  purchaseDate       DateTime?
  warrantyExpiry     DateTime?
  categoryId         String? @db.NVarChar(191)
  statusId           String? @db.NVarChar(191)
  assignedUserId     String? @db.NVarChar(191)
  assignedGuestProfileId String? @db.NVarChar(191)
  assignedLocationId String? @db.NVarChar(191)
  labelTemplateId    String? @db.NVarChar(191)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  category           Category?       @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  status             AssetStatus?    @relation(fields: [statusId], references: [id], onUpdate: NoAction)
  assignedUser       User?           @relation("AssignedUserAssets", fields: [assignedUserId], references: [id], onUpdate: NoAction)
  assignedGuestProfile GuestProfile? @relation("AssignedGuestProfileAssets", fields: [assignedGuestProfileId], references: [id], onUpdate: NoAction)
  assignedLocation   Location?       @relation("AssignedLocationAssets", fields: [assignedLocationId], references: [id], onUpdate: NoAction)
  labelTemplate      LabelTemplate?  @relation(fields: [labelTemplateId], references: [id], onUpdate: NoAction)
  scopes             AssetScope[]
  borrowedItems      BorrowedItem[]   @relation("BorrowedItemAsset")
  activeBorrowedItem BorrowedItem?    @relation("BorrowedItemActiveAsset")

  @@index([assignedGuestProfileId])
}

model BorrowedItem {
  id               String   @id @default(cuid()) @db.NVarChar(191)
  assetId          String? @db.NVarChar(191)
  activeAssetId    String?  @unique @db.NVarChar(191)
  itemName         String? @db.NVarChar(191)
  quantity         Int      @default(1)
  borrowerUserId   String @db.NVarChar(191)
  borrowedAt       DateTime @default(now())
  dueAt            DateTime
  returnedAt       DateTime?
  issuedByUserId   String @db.NVarChar(191)
  returnedByUserId String? @db.NVarChar(191)
  notes            String? @db.NVarChar(Max)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  asset            Asset?   @relation("BorrowedItemAsset", fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activeAsset      Asset?   @relation("BorrowedItemActiveAsset", fields: [activeAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  borrowerUser     User     @relation("BorrowedItemBorrower", fields: [borrowerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  issuedByUser     User     @relation("BorrowedItemIssuedBy", fields: [issuedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  returnedByUser   User?    @relation("BorrowedItemReturnedBy", fields: [returnedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notifications    BorrowedItemNotification[]
  reminderDedupeRecords BorrowedItemReminderDedupe[]

  @@index([assetId])
  @@index([borrowerUserId, returnedAt])
  @@index([dueAt])
  @@index([issuedByUserId])
  @@index([returnedByUserId])
}

model BorrowedItemNotification {
  id             String        @id @default(cuid()) @db.NVarChar(191)
  borrowedItemId String? @db.NVarChar(191)
  dedupeKey      String? @db.NVarChar(191)
  type           String @db.NVarChar(191)
  recipient      String @db.NVarChar(191)
  status         String @db.NVarChar(191)
  sentAt         DateTime?
  error          String? @db.NVarChar(Max)
  createdAt      DateTime      @default(now())
  borrowedItem   BorrowedItem? @relation(fields: [borrowedItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([borrowedItemId, type, status])
  @@index([dedupeKey])
  @@index([type, status, createdAt])
  @@index([recipient])
}

model BorrowedItemReminderDedupe {
  dedupeKey      String        @id @db.NVarChar(191)
  borrowedItemId String? @db.NVarChar(191)
  type           String @db.NVarChar(191)
  scheduledFor   DateTime
  status         String @db.NVarChar(191)
  notificationId String? @db.NVarChar(191)
  lastAttemptAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  borrowedItem   BorrowedItem? @relation(fields: [borrowedItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([borrowedItemId, type, scheduledFor])
  @@index([type, status, scheduledFor])
}

model AssetScope {
  id      String @id @default(cuid()) @db.NVarChar(191)
  assetId String @db.NVarChar(191)
  scopeId String @db.NVarChar(191)
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scope   Scope  @relation(fields: [scopeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assetId, scopeId])
}

model LabelTemplate {
  id                String                 @id @default(cuid()) @db.NVarChar(191)
  name              String @db.NVarChar(191)
  slug              String                 @unique @db.NVarChar(191)
  description       String? @db.NVarChar(Max)
  width             Float                  @map("widthMm")
  height            Float                  @map("heightMm")
  unit              String                 @default("millimeters") @db.NVarChar(191)
  orientation       String                 @default("portrait") @db.NVarChar(191)
  marginTop         Float                  @default(1) @map("marginTopMm")
  marginRight       Float                  @default(1) @map("marginRightMm")
  marginBottom      Float                  @default(1) @map("marginBottomMm")
  marginLeft        Float                  @default(1) @map("marginLeftMm")
  isEnabled         Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  elements          LabelTemplateElement[]
  assets            Asset[]
  defaultCategories Category[]             @relation("CategoryDefaultLabelTemplate")

  @@map("LabelTemplate")
}

model LabelTemplateElement {
  id          String        @id @default(cuid()) @db.NVarChar(191)
  templateId  String @db.NVarChar(191)
  type        String        @default("text") @db.NVarChar(191)
  fieldKey    String @db.NVarChar(191)
  displayName String?       @map("label") @db.NVarChar(191)
  isVisible   Boolean       @default(true)
  x           Float         @map("posX")
  y           Float         @map("posY")
  width       Float
  height      Float
  fontSize    Int?
  fontWeight  String        @default("normal") @db.NVarChar(191)
  italic      Boolean       @default(false)
  textAlign   String        @default("left") @map("alignment") @db.NVarChar(191)
  rotation    Float         @default(0)
  zIndex      Int           @default(0)
  template    LabelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([templateId, zIndex])
  @@map("LabelTemplateField")
}

model Setting {
  id        String   @id @default(cuid()) @db.NVarChar(191)
  category  String @db.NVarChar(191)
  key       String   @unique @db.NVarChar(191)
  value     String @db.NVarChar(Max)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandingAsset {
  id        String   @id @default(cuid()) @db.NVarChar(191)
  kind      String @db.NVarChar(191)
  fileName  String @db.NVarChar(191)
  filePath  String @db.NVarChar(191)
  mimeType  String? @db.NVarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthProviderConfig {
  id          String   @id @default(cuid()) @db.NVarChar(191)
  providerKey String   @unique @db.NVarChar(191)
  isEnabled   Boolean  @default(false)
  configJson  String @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid()) @db.NVarChar(191)
  actorUserId String? @db.NVarChar(191)
  action      String @db.NVarChar(191)
  entityType  String @db.NVarChar(191)
  entityId    String? @db.NVarChar(191)
  summary     String @db.NVarChar(Max)
  payloadJson String? @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onUpdate: NoAction)
}
